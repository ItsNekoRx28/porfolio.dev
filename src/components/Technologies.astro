---
import TailwindIcon from "./icons/Tailwind.astro"
import JavaScriptIcon from "./icons/JavaScript.astro"
import ElixirIcon from "./icons/Elixir.astro"
import PhoenixIcon from "./icons/Phoenix.astro"
import JavaIcon from "./icons/Java.astro"
import PostgreSQLIcon from "./icons/PostgreSQL.astro"
import PythonIcon from "./icons/Python.astro"
import CIcon from "./icons/C.astro"
import DockerIcon from "./icons/Docker.astro"
import GitIcon from "./icons/Git.astro"
import LinuxIcon from "./icons/Linux.astro"

// Ordenadas por importancia para un puesto de backend.
const TECHNOLOGIES: { name: string; icon?: any; colorClasses: string; textColor: "white" | "black" }[] = [
  { name: "Java", icon: JavaIcon, colorClasses: "bg-slate-100 dark:bg-white", textColor: "black" },
  { name: "Elixir", icon: ElixirIcon, colorClasses: "bg-purple-600 dark:bg-purple-900", textColor: "white" },
  { name: "Phoenix / LiveView", icon: PhoenixIcon, colorClasses: "bg-orange-700 dark:bg-orange-900", textColor: "white" },
  { name: "PostgreSQL", icon: PostgreSQLIcon, colorClasses: "bg-[#b8d0e5] dark:bg-[#9db9d2]", textColor: "black" },
  { name: "C", icon: CIcon, colorClasses: "bg-[#364a5e] dark:bg-[#263746]", textColor: "white" },
  { name: "Python", icon: PythonIcon, colorClasses: "bg-[#fff2cc] dark:bg-[#f5e3ad]", textColor: "black" },
  { name: "JavaScript", icon: JavaScriptIcon, colorClasses: "bg-yellow-500 dark:bg-yellow-300/40", textColor: "white" },
  { name: "Tailwind CSS", icon: TailwindIcon, colorClasses: "bg-blue-500 dark:bg-blue-500/40", textColor: "white" },
  { name: "Docker", icon: DockerIcon, colorClasses: "bg-[#d8f1fb] dark:bg-[#bce5f5]", textColor: "black" },
  { name: "Git", icon: GitIcon, colorClasses: "bg-[#fde5df] dark:bg-[#f5cdc3]", textColor: "black" },
  { name: "Linux", icon: LinuxIcon, colorClasses: "bg-gray-800 dark:bg-gray-800", textColor: "white" },
]
---

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
  {
    TECHNOLOGIES.map((technology) => (
      <div class={`flex flex-col items-center justify-center p-4 min-h-28 transition-all duration-300 ${technology.colorClasses} hover:scale-110 rounded-lg shadow-md`}>
        {technology.icon && <technology.icon class="size-12" />}
        <span class={`mt-2 text-sm font-semibold ${technology.textColor === "white" ? "text-white" : "text-black"}`}>{technology.name}</span>
      </div>
    ))
  }
</div>
