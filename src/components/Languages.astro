---
import SpanishIcon from "./icons/Spanish.astro"
import JapaneseIcon from "./icons/Japanese.astro"
import EnglishIcon from "./icons/English.astro"
import type { LanguageItem } from "@/i18n/content"

interface Props {
  items: LanguageItem[]
  certLabel: string
}

const { items, certLabel } = Astro.props

const STYLE = {
  es: { icon: SpanishIcon, colorClasses: "bg-red-600 dark:bg-red-900", text: "text-white" },
  en: { icon: EnglishIcon, colorClasses: "bg-blue-600 dark:bg-blue-900", text: "text-white" },
  ja: { icon: JapaneseIcon, colorClasses: "bg-slate-100 dark:bg-white", text: "text-black" },
}
---

<div class="justify-center grid md:grid-cols-3 gap-4">
  {
    items.map((item) => {
      const s = STYLE[item.key]
      const Tag = item.cert ? "a" : "div"
      return (
        <Tag
          href={item.cert}
          target={item.cert ? "_blank" : undefined}
          title={item.cert ? certLabel : undefined}
          class={`flex flex-col items-center justify-center p-4 transition-all duration-300 ${s.colorClasses} hover:scale-110 rounded-lg shadow-md`}
        >
          <s.icon class="size-12" />
          <span class={`mt-2 text-sm text-center font-semibold ${s.text}`}>{item.name}</span>
          {item.cert && <span class={`mt-1 text-xs underline ${s.text} opacity-80`}>{certLabel}</span>}
        </Tag>
      )
    })
  }
</div>
