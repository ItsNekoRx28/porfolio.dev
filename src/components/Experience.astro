---
import ExperienceItem from "./ExperienceItem.astro"
import type { TimelineItem } from "@/i18n/content"

interface Props {
  items: TimelineItem[]
  labels: { more: string; docs: string }
}

const { items, labels } = Astro.props
---

<ol class="relative mt-16">
  {
    items.map((item) => (
      <li>
        <ExperienceItem {...item} labels={labels} />
      </li>
    ))
  }
</ol>
